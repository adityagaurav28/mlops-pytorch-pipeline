.github/
data/
checkpoints/
env/
venv/
.venv/
__pycache__/
*.py[cod]
*.pt
*.pth
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
k8s/
README.md
assignment.pdf
.DS_Store
